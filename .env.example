# PostgreSQL — VELA operational truth
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/vela?schema=public"

# MongoDB Atlas — VELA computational intelligence memory
MONGODB_ATLAS_URI="mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE="vela_intelligence"

# Authentication / application secrets
SESSION_SECRET="replace-with-a-long-random-secret"
